[options]
; Database settings
db_host = db
db_port = 5432
db_user = odoo
db_password = odoo_secure_password
db_name = hotel_management

; Addons paths: include standard odoo addons and custom hotel modules
addons_path = /mnt/extra-addons

; Server settings
http_port = 8069
proxy_mode = True
list_db = False
admin_passwd = change_this_to_a_strong_master_password

; Performance & Workers (adjust according to server CPU/RAM)
workers = 2
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1200
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648

; Logging
log_level = info
