
[options]

; PostgreSQL settings
db_host = db
db_port = 5432
db_user = odoo
db_password = odoo_secure_password
db_name = hotel_management

; Standard Odoo addons and custom hotel modules
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons

; Server settings
http_port = 8069
proxy_mode = True
list_db = False
admin_passwd = REPLACE_WITH_A_STRONG_MASTER_PASSWORD

; Performance settings
workers = 0
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1200

; Logging
log_level = info
