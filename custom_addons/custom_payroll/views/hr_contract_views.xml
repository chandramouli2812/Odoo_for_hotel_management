<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_list" model="ir.ui.view">
        <field name="name">hr.contract.list</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts" decoration-success="state == 'open'" decoration-muted="state == 'close'" decoration-danger="state == 'cancel'">
                <field name="name" decoration-bf="1"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="wage" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="struct_id"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-info="state == 'draft'" decoration-warning="state == 'close'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_hr_contract_form" model="ir.ui.view">
        <field name="name">hr.contract.form</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <form string="Employee Contract">
                <header>
                    <button name="action_set_running" string="Set to Running" type="object" class="btn-primary" invisible="state == 'open'"/>
                    <button name="action_set_expired" string="Expire Contract" type="object" class="btn-warning" invisible="state not in ('open', 'draft')"/>
                    <button name="action_set_cancel" string="Cancel Contract" type="object" class="btn-secondary" invisible="state in ('cancel', 'close')"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Running" bg_color="text-bg-success" invisible="state != 'open'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-warning" invisible="state != 'close'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <label for="name" string="Contract Reference"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Employee &amp; Position">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Contract Duration">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="trial_date_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Salary &amp; Compensation">
                            <field name="currency_id" invisible="1"/>
                            <field name="wage" widget="monetary" class="text-primary fw-bold fs-4"/>
                            <field name="struct_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Terms &amp; Notes" name="notes">
                            <field name="notes" placeholder="Specify full-time, part-time terms, notice period, or specific conditions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_contract_search" model="ir.ui.view">
        <field name="name">hr.contract.search</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="running" string="Running Contracts" domain="[('state', '=', 'open')]"/>
                <filter name="draft" string="Draft / New" domain="[('state', '=', 'draft')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'close')]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Salary Structure" name="group_by_struct" context="{'group_by': 'struct_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_contract" model="ir.actions.act_window">
        <field name="name">Employee Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_contract_search"/>
        <field name="context">{'search_default_running': 1}</field>
    </record>
</odoo>
