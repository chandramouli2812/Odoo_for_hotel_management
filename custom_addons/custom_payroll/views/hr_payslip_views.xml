<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payslip Form View -->
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Employee Payslip">
                <header>
                    <button name="action_compute_sheet" string="Compute Sheet" type="object" class="btn-primary" invisible="state in ('done', 'paid', 'cancel')"/>
                    <button name="action_payslip_done" string="Confirm" type="object" class="btn-primary" invisible="state != 'verify'"/>
                    <button name="action_register_payment" string="Register Payment" type="object" class="btn-success" invisible="state != 'done'"/>
                    <button name="action_print_payslip" string="Print Payslip" type="object" class="btn-info" invisible="state == 'draft'"/>
                    <button name="action_payslip_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('cancel', 'paid')"/>
                    <button name="action_payslip_draft" string="Set to Draft" type="object" class="btn-secondary" invisible="state not in ('cancel', 'verify')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verify,done,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Confirmed" bg_color="text-bg-primary" invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>

                    <div class="oe_title">
                        <label for="name" string="Payslip Reference"/>
                        <h1>
                            <field name="number" readonly="1" invisible="not number"/>
                            <field name="name" placeholder="Salary Slip - Employee - Month"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Employee Details">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="bank_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Period &amp; Salary Structure">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="contract_id"/>
                            <field name="struct_id"/>
                            <field name="payslip_run_id" invisible="not payslip_run_id"/>
                        </group>
                    </group>

                    <!-- Financial Quick Stats Banner -->
                    <div class="row bg-light rounded p-3 mb-3 border mx-0">
                        <div class="col-md-3 text-center border-end">
                            <span class="text-muted small d-block">Monthly Basic Wage</span>
                            <field name="currency_id" invisible="1"/>
                            <strong class="fs-5 text-dark"><field name="wage" widget="monetary"/></strong>
                        </div>
                        <div class="col-md-3 text-center border-end">
                            <span class="text-muted small d-block">Gross Earnings</span>
                            <strong class="fs-5 text-primary"><field name="gross_wage" widget="monetary"/></strong>
                        </div>
                        <div class="col-md-3 text-center border-end">
                            <span class="text-muted small d-block">Total Deductions</span>
                            <strong class="fs-5 text-danger"><field name="total_deductions" widget="monetary"/></strong>
                        </div>
                        <div class="col-md-3 text-center">
                            <span class="text-muted small d-block">Net Take-Home Pay</span>
                            <strong class="fs-4 text-success"><field name="net_wage" widget="monetary"/></strong>
                        </div>
                    </div>

                    <notebook>
                        <page string="Salary Computation" name="salary_computation">
                            <field name="line_ids" readonly="state in ('done', 'paid')">
                                <list string="Salary Lines" decoration-info="category_id == %(custom_payroll.cat_basic)d" decoration-primary="category_id == %(custom_payroll.cat_alw)d" decoration-danger="category_id == %(custom_payroll.cat_ded)d" decoration-success="category_id == %(custom_payroll.cat_net)d">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category_id"/>
                                    <field name="rate"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="total" widget="monetary" decoration-bf="1"/>
                                    <field name="appears_on_payslip" widget="boolean_toggle"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Worked Days &amp; Inputs" name="worked_days">
                            <field name="worked_days_line_ids" readonly="state in ('done', 'paid')">
                                <list string="Worked Days" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="number_of_days"/>
                                    <field name="number_of_hours"/>
                                </list>
                            </field>
                        </page>

                        <page string="Payment &amp; Disbursement" name="payment_info" invisible="state not in ('done', 'paid')">
                            <group>
                                <group string="Disbursement Record">
                                    <field name="payment_date"/>
                                    <field name="payment_method"/>
                                    <field name="payment_reference"/>
                                </group>
                                <group string="Accounting Integration">
                                    <field name="journal_id"/>
                                    <field name="move_id" invisible="not move_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Internal Notes" name="notes">
                            <field name="note" placeholder="Internal comments or payroll manager notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payslip List View -->
    <record id="view_hr_payslip_list" model="ir.ui.view">
        <field name="name">hr.payslip.list</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list string="Employee Payslips" decoration-info="state == 'draft'" decoration-primary="state == 'verify'" decoration-success="state == 'paid'" decoration-muted="state == 'cancel'">
                <field name="number" decoration-bf="1"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross_wage" widget="monetary"/>
                <field name="total_deductions" widget="monetary" decoration-danger="total_deductions &gt; 0"/>
                <field name="net_wage" widget="monetary" decoration-success="net_wage &gt; 0" decoration-bf="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'verify'" decoration-warning="state == 'done'" decoration-success="state == 'paid'" decoration-danger="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Payslip Kanban View -->
    <record id="view_hr_payslip_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.kanban</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="number"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="net_wage"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column gap-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="fs-6 text-primary"><field name="number" t-if="record.number.raw_value"/><span t-else="">Draft Slip</span></strong>
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'verify'" decoration-warning="state == 'done'" decoration-success="state == 'paid'"/>
                            </div>
                            <div class="text-dark fw-bold"><field name="employee_id"/></div>
                            <div class="text-muted small">
                                <field name="date_from"/> - <field name="date_to"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                <span class="text-muted small">Net Pay:</span>
                                <strong class="text-success fs-5"><field name="net_wage" widget="monetary"/></strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Payslip Search View -->
    <record id="view_hr_payslip_search" model="ir.ui.view">
        <field name="name">hr.payslip.search</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <search string="Search Payslips">
                <field name="number"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="payslip_run_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="verify" string="Computed (To Confirm)" domain="[('state', '=', 'verify')]"/>
                <filter name="done" string="Confirmed (Ready to Pay)" domain="[('state', '=', 'done')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <group>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Batch / Pay Run" name="group_by_run" context="{'group_by': 'payslip_run_id'}"/>
                    <filter string="Date From" name="group_by_date_from" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_payslip" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_hr_payslip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Employee Payslip!
            </p>
            <p>
                Select an employee, pick the month period, and click <b>Compute Sheet</b> to calculate wages, allowances, and deductions automatically.
            </p>
        </field>
    </record>
</odoo>
