<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Payslip -->
        <record id="seq_hr_payslip" model="ir.sequence">
            <field name="name">Employee Payslip Sequence</field>
            <field name="code">hr.payslip</field>
            <field name="prefix">SLIP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Contract -->
        <record id="seq_hr_contract" model="ir.sequence">
            <field name="name">Employee Contract Sequence</field>
            <field name="code">hr.contract</field>
            <field name="prefix">CNT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
