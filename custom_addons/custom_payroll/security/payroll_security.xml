<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_payroll">
        <field name="name">Payroll Management</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_hr_payroll_user" model="res.groups">
        <field name="name">Payroll Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Payroll officer can create, compute, and review payslips and contracts.</field>
    </record>

    <record id="group_hr_payroll_manager" model="res.groups">
        <field name="name">Payroll Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_payroll_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Payroll manager has full access to salary structures, rules, validation, and payment disbursement.</field>
    </record>
</odoo>
