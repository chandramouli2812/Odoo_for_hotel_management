<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
                        <!-- Header Banner -->
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                            <div>
                                <h2 class="text-primary fw-bold mb-0">SALARY PAYSLIP</h2>
                                <span class="text-muted fs-6">Reference: <strong t-esc="o.number or 'Draft'"/></span>
                            </div>
                            <div class="text-end">
                                <span t-if="o.state == 'paid'" class="badge bg-success fs-6 px-3 py-2">PAID</span>
                                <span t-elif="o.state == 'done'" class="badge bg-primary fs-6 px-3 py-2">CONFIRMED</span>
                                <span t-else="" class="badge bg-secondary fs-6 px-3 py-2">DRAFT</span>
                            </div>
                        </div>

                        <!-- Employee & Period Info Card -->
                        <div class="card mb-4 border">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-6">
                                        <table class="table table-sm table-borderless mb-0">
                                            <tr>
                                                <td class="text-muted" style="width: 40%;"><strong>Employee Name:</strong></td>
                                                <td><strong class="text-dark" t-field="o.employee_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted"><strong>Job Position:</strong></td>
                                                <td><span t-field="o.job_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted"><strong>Department:</strong></td>
                                                <td><span t-field="o.department_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted"><strong>Bank Account:</strong></td>
                                                <td><span t-esc="o.bank_account_id.acc_number if o.bank_account_id else 'N/A'"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-6">
                                        <table class="table table-sm table-borderless mb-0">
                                            <tr>
                                                <td class="text-muted" style="width: 40%;"><strong>Pay Period:</strong></td>
                                                <td><span t-field="o.date_from"/> to <span t-field="o.date_to"/></td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted"><strong>Salary Structure:</strong></td>
                                                <td><span t-field="o.struct_id.name"/></td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted"><strong>Basic Wage:</strong></td>
                                                <td><span t-field="o.wage" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            </tr>
                                            <tr t-if="o.payment_date">
                                                <td class="text-muted"><strong>Paid Date / Ref:</strong></td>
                                                <td><span t-field="o.payment_date"/> <span t-if="o.payment_reference"> (Ref: <t t-esc="o.payment_reference"/>)</span></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Worked Days Summary -->
                        <div t-if="o.worked_days_line_ids" class="mb-3">
                            <h6 class="text-muted fw-bold text-uppercase border-bottom pb-1">Attendance &amp; Leave Summary</h6>
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th>Code</th>
                                        <th class="text-center">Days</th>
                                        <th class="text-center">Hours</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.worked_days_line_ids" t-as="wd">
                                        <td><span t-field="wd.name"/></td>
                                        <td><code><span t-field="wd.code"/></code></td>
                                        <td class="text-center"><span t-field="wd.number_of_days"/></td>
                                        <td class="text-center"><span t-field="wd.number_of_hours"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Earnings & Deductions Tables -->
                        <div class="row mb-4">
                            <!-- Earnings -->
                            <div class="col-6">
                                <div class="card h-100 border">
                                    <div class="card-header bg-light py-2">
                                        <strong class="text-success text-uppercase">Earnings &amp; Allowances</strong>
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-light small">
                                                <tr>
                                                    <th>Description</th>
                                                    <th class="text-end">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-set="total_earnings" t-value="0.0"/>
                                                <tr t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code in ('BASIC', 'ALW'))" t-as="el">
                                                    <td><span t-field="el.name"/></td>
                                                    <td class="text-end">
                                                        <span t-field="el.total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                            <tfoot>
                                                <tr class="table-light fw-bold border-top">
                                                    <td>Gross Earnings</td>
                                                    <td class="text-end text-primary">
                                                        <span t-field="o.gross_wage" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Deductions -->
                            <div class="col-6">
                                <div class="card h-100 border">
                                    <div class="card-header bg-light py-2">
                                        <strong class="text-danger text-uppercase">Deductions</strong>
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-light small">
                                                <tr>
                                                    <th>Description</th>
                                                    <th class="text-end">Amount</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code == 'DED')" t-as="dl">
                                                    <td><span t-field="dl.name"/></td>
                                                    <td class="text-end">
                                                        <span t-field="dl.total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                                <tr t-if="not o.line_ids.filtered(lambda l: l.category_id.code == 'DED')">
                                                    <td colspan="2" class="text-center text-muted py-3">No deductions applicable</td>
                                                </tr>
                                            </tbody>
                                            <tfoot>
                                                <tr class="table-light fw-bold border-top">
                                                    <td>Total Deductions</td>
                                                    <td class="text-end text-danger">
                                                        <span t-field="o.total_deductions" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Net Salary Highlight Card -->
                        <div class="card bg-light border-success mb-5">
                            <div class="card-body d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h4 class="mb-0 text-success fw-bold">NET TAKE-HOME PAY</h4>
                                    <span class="text-muted small">Gross Earnings minus Deductions</span>
                                </div>
                                <div>
                                    <span class="fs-2 fw-bold text-success" t-field="o.net_wage" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </div>
                            </div>
                        </div>

                        <!-- Signatures & Authorization -->
                        <div class="row pt-5 mt-5">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #999; width: 80%; margin: 0 auto; padding-top: 5px;">
                                    <strong class="text-muted">Prepared By (HR / Payroll)</strong>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #999; width: 80%; margin: 0 auto; padding-top: 5px;">
                                    <strong class="text-muted">Employee Signature / Acknowledgment</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
