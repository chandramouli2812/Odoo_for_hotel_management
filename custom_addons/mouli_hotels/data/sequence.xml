<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Hotel Reservation -->
        <record id="seq_hotel_reservation" model="ir.sequence">
            <field name="name">Hotel Reservation Sequence</field>
            <field name="code">hotel.reservation</field>
            <field name="prefix">RES/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Guest Folio -->
        <record id="seq_hotel_folio" model="ir.sequence">
            <field name="name">Hotel Folio Sequence</field>
            <field name="code">hotel.folio</field>
            <field name="prefix">FOL/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Housekeeping Tasks -->
        <record id="seq_hotel_housekeeping_task" model="ir.sequence">
            <field name="name">Housekeeping Task Sequence</field>
            <field name="code">hotel.housekeeping.task</field>
            <field name="prefix">HK/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Breakfast Service Attendance -->
        <record id="seq_hotel_breakfast_service" model="ir.sequence">
            <field name="name">Breakfast Service Sequence</field>
            <field name="code">hotel.breakfast.service</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
