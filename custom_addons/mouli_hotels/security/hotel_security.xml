<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_mouli_hotel">
        <field name="name">Hotel Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_hotel_housekeeping" model="res.groups">
        <field name="name">Housekeeping Staff</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mouli_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Housekeeping staff can view rooms and manage housekeeping tasks.</field>
    </record>

    <record id="group_hotel_user" model="res.groups">
        <field name="name">Front Desk / Receptionist</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mouli_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Front desk receptionists can manage reservations, check-in, folios, and guest records.</field>
    </record>

    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Hotel Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_mouli_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_user')), (4, ref('group_hotel_housekeeping'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Hotel managers have full access to configuration, properties, rooms, reservations, and financial folios.</field>
    </record>
</odoo>
