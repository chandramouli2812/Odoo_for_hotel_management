<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hotel Property Form View -->
    <record id="view_hotel_property_form" model="ir.ui.view">
        <field name="name">hotel.property.form</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <form string="Hotel Property">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name" string="Property Name"/>
                        <h1><field name="name" placeholder="e.g. Mouli Grand Resort &amp; Spa"/></h1>
                        <h3><field name="code" placeholder="e.g. MGR01"/></h3>
                    </div>
                    <group>
                        <group string="Location &amp; Contact">
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True}"/>
                            </div>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group string="Statistics &amp; Operations">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_rooms"/>
                            <field name="occupied_rooms"/>
                            <field name="available_rooms"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Buildings / Wings" name="buildings">
                            <field name="building_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="floor_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Floors" name="floors">
                            <field name="floor_ids">
                                <list editable="bottom">
                                    <field name="floor_number"/>
                                    <field name="name"/>
                                    <field name="building_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rooms" name="rooms">
                            <field name="room_ids" readonly="1">
                                <list>
                                    <field name="room_number"/>
                                    <field name="room_type_id"/>
                                    <field name="floor_id"/>
                                    <field name="occupancy_status" widget="badge" decoration-success="occupancy_status == 'vacant'" decoration-warning="occupancy_status == 'reserved'" decoration-danger="occupancy_status == 'occupied'"/>
                                    <field name="housekeeping_status" widget="badge" decoration-success="housekeeping_status in ('clean', 'inspected')" decoration-danger="housekeeping_status == 'dirty'"/>
                                    <field name="maintenance_status" widget="badge" decoration-success="maintenance_status == 'operational'" decoration-danger="maintenance_status != 'operational'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Hotel Property List View -->
    <record id="view_hotel_property_list" model="ir.ui.view">
        <field name="name">hotel.property.list</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="total_rooms"/>
                <field name="available_rooms"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Hotel Property Action -->
    <record id="action_hotel_property" model="ir.actions.act_window">
        <field name="name">Hotel Properties</field>
        <field name="res_model">hotel.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Hotel or Resort Property!
            </p>
        </field>
    </record>
</odoo>
