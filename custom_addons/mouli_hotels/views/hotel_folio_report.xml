<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Clean Paperformat for Guest Folio (balanced 10mm margins, zero top clutter) -->
    <record id="paperformat_hotel_folio" model="report.paperformat">
        <field name="name">Hotel Guest Folio A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_hotel_folio_bill" model="ir.actions.report">
        <field name="name">Guest Folio &amp; Invoice</field>
        <field name="model">hotel.folio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mouli_hotels.report_hotel_folio_bill_document</field>
        <field name="print_report_name">'Guest_Folio_%s' % (object.name or 'Bill')</field>
        <field name="binding_model_id" ref="model_hotel_folio"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_hotel_folio"/>
    </record>

    <!-- Main Folio Document Template -->
    <template id="report_hotel_folio_bill_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, 'Segoe UI', Tahoma, sans-serif; font-size: 11px; color: #1e293b; line-height: 1.45; padding: 10px 10px;">
                        
                        <!-- Top Resort Header & Folio Meta Banner with Company Logo on Right -->
                        <div style="width: 100%; border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 16px;">
                            <div style="width: 58%; float: left;">
                                <div style="font-size: 9px; text-transform: uppercase; color: #1e40af; font-weight: 700; margin-bottom: 3px;">
                                    Mouli Hotels &amp; Resorts Management
                                </div>
                                <h1 style="margin: 0 0 4px 0; font-size: 22px; font-weight: 800; color: #0f172a; line-height: 1.15;">
                                    <span t-out="(o.property_id and o.property_id.name) or 'RB Resorts'"/>
                                </h1>
                                <div style="font-size: 9.5px; color: #64748b; line-height: 1.4;" t-if="o.property_id">
                                    <span t-if="o.property_id.address" t-out="o.property_id.address"/><br t-if="o.property_id.address"/>
                                    <span t-if="o.property_id.phone">Phone: <strong style="color: #334155;"><span t-out="o.property_id.phone"/></strong></span>
                                    <span t-if="o.property_id.phone and o.property_id.email"> | </span>
                                    <span t-if="o.property_id.email">Email: <span t-out="o.property_id.email"/></span>
                                    <span t-if="o.property_id.website"> | Web: <span t-out="o.property_id.website"/></span>
                                </div>
                            </div>
                            <div style="width: 42%; float: right; text-align: right;">
                                <!-- Dynamic Company Logo -->
                                <div t-if="o.company_id.logo or res_company.logo" style="margin-bottom: 6px;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 42px; max-width: 150px; object-fit: contain;" alt="Company Logo"/>
                                    <img t-elif="res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="max-height: 42px; max-width: 150px; object-fit: contain;" alt="Company Logo"/>
                                </div>
                                <div style="font-size: 15px; font-weight: 800; color: #0f172a; text-transform: uppercase; margin-bottom: 5px;">
                                    Guest Stay Folio &amp; Tax Bill
                                </div>
                                <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 4px; padding: 5px 10px; display: inline-block; text-align: left; margin-bottom: 5px;">
                                    <div style="font-size: 9.5px; margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 70px;">Folio No:</span>
                                        <span style="font-family: 'Consolas', 'Courier New', monospace; font-size: 11.5px; font-weight: 700; color: #0f172a;" t-field="o.name"/>
                                    </div>
                                    <div style="font-size: 9.5px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 70px;">Billing Date:</span>
                                        <span style="font-weight: 600; color: #0f172a;" t-field="o.date_order" t-options='{"widget": "date"}'/>
                                    </div>
                                </div>
                                <div>
                                    <t t-if="o.payment_status == 'paid'">
                                        <span style="background-color: #15803d; color: #ffffff; padding: 3px 10px; border-radius: 4px; font-size: 9.5px; font-weight: 700; display: inline-block;">
                                            PAID &amp; CLEARED
                                        </span>
                                    </t>
                                    <t t-elif="o.payment_status == 'partial'">
                                        <span style="background-color: #b45309; color: #ffffff; padding: 3px 10px; border-radius: 4px; font-size: 9.5px; font-weight: 700; display: inline-block;">
                                            PARTIALLY SETTLED
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span style="background-color: #b91c1c; color: #ffffff; padding: 3px 10px; border-radius: 4px; font-size: 9.5px; font-weight: 700; display: inline-block;">
                                            PAYMENT DUE
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div style="clear: both;"/>
                        </div>

                        <!-- Guest & Stay Information Grid -->
                        <div style="width: 100%; margin-bottom: 16px;">
                            <!-- Left: Guest Particulars -->
                            <div style="width: 48.5%; float: left; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 5px; padding: 10px 14px; box-sizing: border-box; min-height: 125px;">
                                <div style="font-size: 9px; text-transform: uppercase; color: #1e40af; font-weight: 700; margin-bottom: 3px;">
                                    Guest Particulars
                                </div>
                                <div style="font-size: 13.5px; font-weight: 700; color: #0f172a; margin-bottom: 6px;">
                                    <span t-field="o.guest_id.name"/>
                                </div>
                                <div style="font-size: 9.5px; line-height: 1.5;">
                                    <div t-if="o.guest_id.phone" style="margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 75px;">Phone:</span>
                                        <span style="color: #0f172a; font-weight: 500;" t-field="o.guest_id.phone"/>
                                    </div>
                                    <div t-if="o.guest_id.email" style="margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 75px;">Email:</span>
                                        <span style="color: #0f172a; font-weight: 500;" t-field="o.guest_id.email"/>
                                    </div>
                                    <div t-if="o.guest_id.id_number" style="margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 75px;">ID:</span>
                                        <span style="color: #0f172a; font-weight: 500;">
                                            <span t-field="o.guest_id.id_type"/> - <span t-field="o.guest_id.id_number"/>
                                        </span>
                                    </div>
                                    <div t-if="o.guest_id.nationality_id">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 75px;">Nationality:</span>
                                        <span style="color: #0f172a; font-weight: 500;" t-field="o.guest_id.nationality_id.name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Stay & Reservation Details -->
                            <div style="width: 48.5%; float: right; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 5px; padding: 10px 14px; box-sizing: border-box; min-height: 125px;">
                                <div style="font-size: 9px; text-transform: uppercase; color: #1e40af; font-weight: 700; margin-bottom: 3px;">
                                    Stay &amp; Reservation Details
                                </div>
                                <div style="font-size: 13.5px; font-weight: 700; color: #0f172a; margin-bottom: 6px;">
                                    <span t-field="o.room_id.name"/>
                                </div>
                                <div style="font-size: 9.5px; line-height: 1.5;">
                                    <div t-if="o.reservation_id" style="margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 95px;">Reservation No:</span>
                                        <span style="color: #0f172a; font-weight: 500;" t-field="o.reservation_id.name"/>
                                    </div>
                                    <div t-if="o.reservation_id" style="margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 95px;">Check-In:</span>
                                        <span style="color: #0f172a; font-weight: 500;" t-field="o.reservation_id.check_in" t-options='{"widget": "datetime"}'/>
                                    </div>
                                    <div t-if="o.reservation_id" style="margin-bottom: 2px;">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 95px;">Check-Out:</span>
                                        <span style="color: #0f172a; font-weight: 500;">
                                            <span t-field="o.reservation_id.check_out" t-options='{"widget": "datetime"}'/>
                                            (<span t-field="o.reservation_id.nights"/> Nights)
                                        </span>
                                    </div>
                                    <div t-if="o.reservation_id and o.reservation_id.meal_plan">
                                        <span style="color: #64748b; font-weight: 600; display: inline-block; width: 95px;">Meal Plan:</span>
                                        <span style="color: #0f172a; font-weight: 500;" t-field="o.reservation_id.meal_plan"/>
                                    </div>
                                </div>
                            </div>
                            <div style="clear: both;"/>
                        </div>

                        <!-- Itemized Charges Table -->
                        <div style="font-size: 10.5px; font-weight: 700; color: #0f172a; text-transform: uppercase; margin-bottom: 5px;">
                            Itemized Charges &amp; Services
                        </div>
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; border: 1px solid #cbd5e1;">
                            <thead>
                                <tr style="background-color: #0f172a; color: #ffffff;">
                                    <th style="padding: 6px 8px; font-size: 9.5px; font-weight: 700; width: 5%; text-align: center; border: 1px solid #334155;">#</th>
                                    <th style="padding: 6px 8px; font-size: 9.5px; font-weight: 700; width: 45%; text-align: left; border: 1px solid #334155;">Service Description</th>
                                    <th style="padding: 6px 8px; font-size: 9.5px; font-weight: 700; width: 16%; text-align: center; border: 1px solid #334155;">Category</th>
                                    <th style="padding: 6px 8px; font-size: 9.5px; font-weight: 700; width: 8%; text-align: center; border: 1px solid #334155;">Qty</th>
                                    <th style="padding: 6px 8px; font-size: 9.5px; font-weight: 700; width: 13%; text-align: right; border: 1px solid #334155;">Unit Rate</th>
                                    <th style="padding: 6px 8px; font-size: 9.5px; font-weight: 700; width: 13%; text-align: right; border: 1px solid #334155;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="1"/>
                                <tr t-foreach="o.line_ids" t-as="line" t-att-style="'background-color: #f8fafc;' if idx % 2 == 0 else 'background-color: #ffffff;'">
                                    <td style="padding: 6px 8px; text-align: center; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 9.5px;">
                                        <span t-out="idx"/>
                                    </td>
                                    <td style="padding: 6px 8px; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 10px; font-weight: 600;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding: 6px 8px; text-align: center; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 8.5px;">
                                        <span style="background-color: #f1f5f9; color: #475569; padding: 2px 6px; border-radius: 3px; font-weight: 600; text-transform: uppercase; display: inline-block; white-space: nowrap; border: 1px solid #e2e8f0;" t-field="line.service_type"/>
                                    </td>
                                    <td style="padding: 6px 8px; text-align: center; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 9.5px;">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td style="padding: 6px 8px; text-align: right; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 9.5px;">
                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td style="padding: 6px 8px; text-align: right; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 10px; font-weight: 700; color: #0f172a;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <t t-set="idx" t-value="idx + 1"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Payment & Advance History Table -->
                        <t t-if="o.payment_ids">
                            <div style="font-size: 10.5px; font-weight: 700; color: #0f172a; text-transform: uppercase; margin-bottom: 5px;">
                                Payments, Advance Deposits &amp; Settlements Received
                            </div>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px; border: 1px solid #cbd5e1;">
                                <thead>
                                    <tr style="background-color: #334155; color: #ffffff;">
                                        <th style="padding: 5px 8px; font-size: 9.5px; font-weight: 700; width: 25%; text-align: left; border: 1px solid #475569;">Payment Date</th>
                                        <th style="padding: 5px 8px; font-size: 9.5px; font-weight: 700; width: 33%; text-align: left; border: 1px solid #475569;">Payment Reference / Title</th>
                                        <th style="padding: 5px 8px; font-size: 9.5px; font-weight: 700; width: 20%; text-align: center; border: 1px solid #475569;">Mode</th>
                                        <th style="padding: 5px 8px; font-size: 9.5px; font-weight: 700; width: 22%; text-align: right; border: 1px solid #475569;">Amount Paid</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.payment_ids" t-as="pay" style="background-color: #ffffff;">
                                        <td style="padding: 5px 8px; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 9.5px;">
                                            <span t-field="pay.payment_date" t-options='{"widget": "datetime"}'/>
                                        </td>
                                        <td style="padding: 5px 8px; vertical-align: middle; border: 1px solid #e2e8f0; font-size: 9.5px;">
                                            <span style="font-weight: 600;" t-field="pay.name"/>
                                            <span t-if="pay.is_advance" style="background-color: #dbeafe; color: #1e40af; font-size: 8px; padding: 2px 5px; border-radius: 3px; font-weight: 700; margin-left: 6px; display: inline-block; vertical-align: middle;">
                                                Advance Deposit
                                            </span>
                                        </td>
                                        <td style="padding: 5px 8px; vertical-align: middle; text-align: center; border: 1px solid #e2e8f0; font-size: 9.5px; text-transform: uppercase;">
                                            <span t-field="pay.payment_method"/>
                                        </td>
                                        <td style="padding: 5px 8px; vertical-align: middle; text-align: right; border: 1px solid #e2e8f0; font-size: 10px; font-weight: 700; color: #15803d;">
                                            <span t-field="pay.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- Financial Summary & Terms Breakdown Table -->
                        <div style="width: 100%; margin-bottom: 20px;">
                            <!-- Left: Terms -->
                            <div style="width: 52%; float: left; background-color: #f1f5f9; padding: 10px 14px; border-radius: 4px; border: 1px solid #cbd5e1; font-size: 9px; color: #475569; line-height: 1.45; box-sizing: border-box;">
                                <strong style="color: #0f172a; font-size: 9.5px;">Billing &amp; Tax Terms:</strong>
                                <ul style="margin: 4px 0 0 0; padding-left: 16px; list-style-type: square;">
                                    <li style="margin-bottom: 3px;">All room and incidental charges are subject to applicable Goods and Services Tax (GST).</li>
                                    <li style="margin-bottom: 3px;">Check-out time is 11:00 AM. Late check-out without prior authorization may attract additional half-day charges.</li>
                                    <li>Queries regarding this statement must be brought to the front office cashier's attention before departure.</li>
                                </ul>
                            </div>

                            <!-- Right: Financial Totals Breakdown -->
                            <div style="width: 45%; float: right; border: 1px solid #cbd5e1; border-radius: 4px; overflow: hidden; box-sizing: border-box;">
                                <table style="width: 100%; border-collapse: collapse; font-size: 10.5px;">
                                    <tr>
                                        <td style="padding: 6px 10px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; font-weight: 600; color: #475569;">
                                            Total Stay Charges:
                                        </td>
                                        <td style="padding: 6px 10px; background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; text-align: right; font-weight: 700; color: #0f172a;">
                                            <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 10px; background-color: #f0fdf4; border-bottom: 1px solid #e2e8f0; font-weight: 600; color: #166534;">
                                            Total Amount Received:
                                        </td>
                                        <td style="padding: 6px 10px; background-color: #f0fdf4; border-bottom: 1px solid #e2e8f0; text-align: right; font-weight: 700; color: #15803d;">
                                            - <span t-field="o.amount_paid" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-att-style="'background-color: #fef2f2;' if o.amount_due &gt; 0 else 'background-color: #f0fdf4;'">
                                        <td style="padding: 7px 10px; font-weight: 800; font-size: 11px;" t-att-style="'color: #b91c1c;' if o.amount_due &gt; 0 else 'color: #15803d;'">
                                            <t t-if="o.amount_due &gt; 0">OUTSTANDING BALANCE DUE:</t>
                                            <t t-else="">BALANCE CLEARED / NIL:</t>
                                        </td>
                                        <td style="padding: 7px 10px; text-align: right; font-weight: 800; font-size: 12px;" t-att-style="'color: #b91c1c;' if o.amount_due &gt; 0 else 'color: #15803d;'">
                                            <span t-field="o.amount_due" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div style="clear: both;"/>
                        </div>

                        <!-- Official Signatures Block -->
                        <div style="width: 100%; margin-top: 26px; margin-bottom: 10px;">
                            <div style="width: 42%; float: left; text-align: center;">
                                <div style="border-top: 1.5px solid #64748b; padding-top: 6px; font-size: 10px; font-weight: 700; color: #334155;">
                                    Guest Signature
                                    <div style="font-size: 8.5px; font-weight: normal; color: #64748b; margin-top: 2px;">
                                        (I accept and acknowledge the charges billed above)
                                    </div>
                                </div>
                            </div>
                            <div style="width: 42%; float: right; text-align: center;">
                                <div style="border-top: 1.5px solid #64748b; padding-top: 6px; font-size: 10px; font-weight: 700; color: #334155;">
                                    Duty Manager / Front Desk Cashier
                                    <div style="font-size: 8.5px; font-weight: normal; color: #64748b; margin-top: 2px;">
                                        (Authorized Resort Official Seal)
                                    </div>
                                </div>
                            </div>
                            <div style="clear: both;"/>
                        </div>

                        <!-- Thank You Footer Note -->
                        <div style="text-align: center; font-size: 9px; color: #64748b; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 8px;">
                            Thank you for staying with us at Mouli Hotels &amp; Resorts! We look forward to welcoming you back soon.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
