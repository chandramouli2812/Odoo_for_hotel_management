<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban View: Visual Drag-and-Drop Workflow -->
    <record id="view_compliance_guest_report_kanban" model="ir.ui.view">
        <field name="name">compliance.guest.report.kanban</field>
        <field name="model">compliance.guest.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="nationality_id"/>
                <field name="id_type"/>
                <field name="id_number"/>
                <field name="reporting_type"/>
                <field name="arrival_date"/>
                <field name="state"/>
                <field name="verification_status"/>
                <field name="is_paperless"/>
                <field name="is_foreign_national"/>
                <field name="is_long_stay"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2 mb-2 rounded shadow-sm border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge text-bg-dark text-white font-monospace px-2 py-1 shadow-sm" style="background-color: #0f172a !important; color: #ffffff !important; border: 1px solid #334155 !important;">
                                    <span style="color: #ffffff !important; font-weight: 700;">
                                        <field name="name" class="text-white"/>
                                    </span>
                                </span>
                                <span t-if="record.is_paperless.raw_value" class="badge bg-success-subtle text-success border border-success">
                                    <i class="fa fa-leaf text-success me-1"/> Paperless
                                </span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <strong class="fs-6 text-primary"><field name="guest_id"/></strong>
                                <span t-if="record.is_foreign_national.raw_value" class="badge bg-warning text-dark">Foreign</span>
                            </div>

                            <div class="text-muted small mb-2">
                                <span t-if="record.room_id.raw_value" class="badge bg-primary text-white me-1">
                                    Room <field name="room_id"/>
                                </span>
                                <span><field name="nationality_id"/></span> • 
                                <span><field name="reporting_type"/></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                <div>
                                    <span t-if="record.verification_status.raw_value == 'verified'" class="badge bg-success">
                                        ID Verified
                                    </span>
                                    <span t-elif="record.verification_status.raw_value == 'pending'" class="badge bg-warning text-dark">
                                        Unverified
                                    </span>
                                    <span t-else="" class="badge bg-danger">
                                        Flagged
                                    </span>
                                </div>
                                <div class="text-end">
                                    <button t-if="record.state.raw_value == 'draft'" name="action_quick_verify_id" type="object" class="btn btn-sm btn-outline-success">
                                        Verify &amp; Ready
                                    </button>
                                    <button t-elif="record.state.raw_value == 'pending_review' || record.state.raw_value == 'ready'" name="action_quick_digital_submit" type="object" class="btn btn-sm btn-primary">
                                        e-Submit
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List / Tree View -->
    <record id="view_compliance_guest_report_tree" model="ir.ui.view">
        <field name="name">compliance.guest.report.tree</field>
        <field name="model">compliance.guest.report</field>
        <field name="arch" type="xml">
            <list string="Police Guest Intimations"
                  decoration-muted="state == 'closed'"
                  decoration-info="state == 'pending_review'"
                  decoration-warning="state == 'ready'"
                  decoration-primary="state == 'submitted'"
                  decoration-success="state == 'acknowledged'"
                  decoration-danger="state == 'cancelled'">
                <field name="name" decoration-bf="1"/>
                <field name="is_paperless" widget="badge" string="Eco Mode"
                       decoration-success="is_paperless == True"/>
                <field name="reporting_type" widget="badge"/>
                <field name="guest_id"/>
                <field name="nationality_id"/>
                <field name="room_id"/>
                <field name="id_type"/>
                <field name="id_number"/>
                <field name="arrival_date"/>
                <field name="departure_date"/>
                <field name="duration_days" string="Nights"/>
                <field name="authority_name"/>
                <field name="submission_ref"/>
                <field name="verification_status" widget="badge"
                       decoration-success="verification_status == 'verified'"
                       decoration-warning="verification_status == 'pending'"
                       decoration-danger="verification_status == 'flagged'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending_review'"
                       decoration-warning="state == 'ready'"
                       decoration-primary="state == 'submitted'"
                       decoration-success="state == 'acknowledged'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_compliance_guest_report_form" model="ir.ui.view">
        <field name="name">compliance.guest.report.form</field>
        <field name="model">compliance.guest.report</field>
        <field name="arch" type="xml">
            <form string="Police Guest Intimation">
                <header>
                    <button name="action_auto_fill_details" string="Auto-Fill from Check-in" icon="fa-magic" type="object" class="btn-outline-primary" invisible="state not in ('draft', 'pending_review')"/>
                    <button name="action_quick_verify_id" string="1-Click Verify ID" icon="fa-check" type="object" class="btn-success" invisible="state != 'pending_review'"/>
                    <button name="action_quick_digital_submit" string="1-Click Digital Submit" icon="fa-bolt" type="object" class="btn-primary" invisible="state not in ('ready', 'pending_review')"/>
                    <button name="action_mark_acknowledged" string="Mark Acknowledged" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_close" string="Close &amp; Archive" type="object" invisible="state != 'acknowledged'"/>
                    <button name="action_create_foreign_record" string="Open / Generate Form C (FRRO)" type="object" class="btn-secondary" invisible="not is_foreign_national"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state in ('draft', 'closed')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_review,ready,submitted,acknowledged,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Acknowledged" bg_color="text-bg-success" invisible="state != 'acknowledged'"/>
                    <widget name="web_ribbon" title="Submitted to Police" bg_color="text-bg-primary" invisible="state != 'submitted'"/>
                    <widget name="web_ribbon" title="Ready to File" bg_color="text-bg-warning" invisible="state != 'ready'"/>
                    <!-- Eco-Friendly & Guidance Ribbons -->
                    <div class="alert alert-success d-flex align-items-center justify-content-between mb-2 py-2" role="alert">
                        <div>
                            <i class="fa fa-leaf text-success fs-5 me-2"/>
                            <strong>100% Paperless Digital Filing:</strong> Processed without printing to reduce resort carbon footprint.
                            <span class="badge bg-success ms-2"><field name="paper_sheets_saved" readonly="1"/> Sheets of Paper Saved</span>
                        </div>
                        <div invisible="not digital_verification_seal">
                            <span class="badge text-bg-dark text-white font-monospace px-2 py-1 shadow-sm" style="background-color: #0f172a !important; color: #ffffff !important; border: 1px solid #334155 !important;" title="Digital Verification Seal">
                                <span style="color: #ffffff !important; font-weight: 700;">
                                    <field name="digital_verification_seal" readonly="1" class="text-white"/>
                                </span>
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 mb-3" role="alert">
                        <strong>3-Step Workflow Guide:</strong>
                        <strong>1.</strong> Click <em>"Auto-Fill from Check-in"</em> ➔
                        <strong>2.</strong> Check ID Number &amp; click <em>"1-Click Verify ID"</em> ➔
                        <strong>3.</strong> Click <em>"1-Click Digital Submit"</em> to file electronically with local police station.
                    </div>

                    <div class="oe_title">
                        <span class="o_form_label text-muted">Police Intimation Record</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Guest Information">
                            <field name="guest_id" options="{'no_quick_create': True}" placeholder="Select in-house or arriving guest..."/>
                            <field name="nationality_id" options="{'no_quick_create': True}"/>
                            <field name="is_foreign_national" invisible="1"/>
                            <field name="guest_phone" widget="phone"/>
                            <field name="guest_email" widget="email"/>
                            <field name="permanent_address" placeholder="Residential permanent address..."/>
                        </group>
                        <group string="Identity Verification">
                            <field name="id_type"/>
                            <field name="id_number" placeholder="Enter Aadhaar (12 digits) or Passport Number"/>
                            <field name="id_expiry_date"/>
                            <field name="verification_status" widget="radio" options="{'horizontal': true}"/>
                            <field name="reporting_type"/>
                            <field name="is_paperless" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group>
                        <group string="Stay &amp; Room Details">
                            <field name="reservation_id" placeholder="Associated Booking / Folio"/>
                            <field name="room_id"/>
                            <field name="property_id"/>
                            <field name="arrival_date"/>
                            <field name="departure_date"/>
                            <label for="duration_days" string="Duration"/>
                            <div>
                                <field name="duration_days" class="oe_inline"/> Nights/Days
                                <span invisible="not is_long_stay" class="badge bg-warning ms-2">Long Stay (&gt;14 Days)</span>
                            </div>
                            <field name="is_long_stay" invisible="1"/>
                            <field name="purpose_of_stay"/>
                        </group>
                        <group string="Police &amp; Authority Submission">
                            <field name="authority_name"/>
                            <field name="police_station_jurisdiction" placeholder="Beat / Station Jurisdiction"/>
                            <field name="submission_mode"/>
                            <field name="submission_date"/>
                            <field name="submission_ref" placeholder="Station Inward / Portal Ack Slip No."/>
                            <field name="submitted_by_id" readonly="1"/>
                            <field name="reviewed_by_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Confidential Notes &amp; Police Instructions" name="remarks">
                            <field name="remarks" placeholder="Enter any specific directives from police station, security cautions, or legal notes..."/>
                        </page>
                        <page string="Accompanying Persons" name="accompanying">
                            <group>
                                <field name="accompanying_adults"/>
                                <field name="accompanying_children"/>
                            </group>
                            <separator string="Accompanying Person Names &amp; IDs"/>
                            <field name="accompanying_details" placeholder="Full names, age, relationship and ID numbers of accompanying guests..."/>
                        </page>
                        <page string="Digital ID Proofs &amp; Acknowledgements" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_compliance_guest_report_search" model="ir.ui.view">
        <field name="name">compliance.guest.report.search</field>
        <field name="model">compliance.guest.report</field>
        <field name="arch" type="xml">
            <search string="Search Police Reports">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="id_number"/>
                <field name="submission_ref"/>
                <field name="authority_name"/>
                <field name="room_id"/>
                <separator/>
                <filter string="Today's Arrivals" name="filter_today_arrivals"
                        domain="[('arrival_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('arrival_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Paperless Digital" name="filter_paperless" domain="[('is_paperless', '=', True)]"/>
                <filter string="Foreign Nationals" name="filter_foreign" domain="[('is_foreign_national', '=', True)]"/>
                <filter string="Domestic Guests" name="filter_domestic" domain="[('is_foreign_national', '=', False)]"/>
                <filter string="Long Stay (&gt;14 Days)" name="filter_long_stay" domain="[('is_long_stay', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Review" name="filter_pending" domain="[('state', '=', 'pending_review')]"/>
                <filter string="Ready for Submission" name="filter_ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Submitted to Police" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Acknowledged" name="filter_acknowledged" domain="[('state', '=', 'acknowledged')]"/>
                <group>
                    <filter string="Reporting Category" name="group_category" context="{'group_by': 'reporting_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Nationality" name="group_nationality" context="{'group_by': 'nationality_id'}"/>
                    <filter string="Authority / Police Station" name="group_authority" context="{'group_by': 'authority_name'}"/>
                    <filter string="Arrival Date" name="group_arrival_date" context="{'group_by': 'arrival_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_compliance_guest_report_graph" model="ir.ui.view">
        <field name="name">compliance.guest.report.graph</field>
        <field name="model">compliance.guest.report</field>
        <field name="arch" type="xml">
            <graph string="Police Submissions by Category" type="bar">
                <field name="reporting_type"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_compliance_guest_report_pivot" model="ir.ui.view">
        <field name="name">compliance.guest.report.pivot</field>
        <field name="model">compliance.guest.report</field>
        <field name="arch" type="xml">
            <pivot string="Compliance Analysis">
                <field name="nationality_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_compliance_guest_reports_all" model="ir.actions.act_window">
        <field name="name">Guest Police Reports</field>
        <field name="res_model">compliance.guest.report</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_compliance_guest_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first Police Guest Intimation Report
            </p>
            <p>
                Keep official guest arrival, domestic and long-stay guest records for local law enforcement submission.
            </p>
        </field>
    </record>

    <record id="action_compliance_guest_reports_today" model="ir.actions.act_window">
        <field name="name">Today's Police Intimations</field>
        <field name="res_model">compliance.guest.report</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('arrival_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('arrival_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>

    <record id="action_compliance_guest_reports_pending" model="ir.actions.act_window">
        <field name="name">Pending Police Submissions</field>
        <field name="res_model">compliance.guest.report</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'in', ('pending_review', 'ready'))]</field>
    </record>

    <record id="action_compliance_guest_reports_long_stay" model="ir.actions.act_window">
        <field name="name">Long-Stay Guest Reports (&gt;14 Days)</field>
        <field name="res_model">compliance.guest.report</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_long_stay', '=', True)]</field>
    </record>
</odoo>
